# ====== pi configuration example (edit this file) ======
# THIS FILE IS A TEMPLATE. Copy it to `pi.conf` (gitignored) and fill in your
# own folders/keys — never commit your real pi.conf.
#   cp pi.conf.example pi.conf
# pi.sh auto-creates pi.conf from this example on first run if it is missing.

# Allowed folders: the container sees ONLY these. Never list pi-sandbox itself,
# a folder inside it, or a parent of it (~, ~/Workspace): the agent could
# rewrite pi.conf/pi.sh and get them run on the host. pi.sh skips such entries.
# - Launched from inside one → confined to that folder, mounted at its real
#   path (pi's footer shows the actual location).
# - Launched elsewhere and answering "n" → all mounted under $WORKSPACE/<name>.
ALLOWED=(
  "$HOME/<your-project-path>"                       # e.g. ~/my-project
)

# API keys, by variable name. Each one is read from your shell if exported
# there, else from the macOS Keychain (service "pi-sandbox"). To store one:
#   security add-generic-password -U -s pi-sandbox -a OPENAI_API_KEY -w
# Supported keys never enter the container: pi only sees the value "proxy" and
# the keyproxy sidecar adds the real key (list in README, "Supported keys"):
#   ANTHROPIC_API_KEY   DEEPSEEK_API_KEY    GEMINI_API_KEY
#   GROQ_API_KEY        MISTRAL_API_KEY     OPENAI_API_KEY
#   OPENROUTER_API_KEY  TAVILY_API_KEY      XAI_API_KEY
# Any other name is passed as a plain env var: the agent can read it.
API_KEYS=(
  TAVILY_API_KEY
  OPENAI_API_KEY
  DEEPSEEK_API_KEY
)

# Image and volume (volume = sessions/config/extensions, persists across launches)
IMAGE="pi-sandbox"
VOLUME="pi-agent-home"
# rtk data (history / `rtk gain` stats) — named volume, same isolation as VOLUME
RTK_VOLUME="rtk-data"
# Container-side mount point for the NON-confined fallback only
# (confined launches mount the folder at its real host path).
WORKSPACE="/workspace"

# Extra docker arguments for the pi container.
# No --network/--net: pi.sh puts pi on the keyproxy sidecar's network itself
# and refuses to start if one is set here while a key is proxied.
# PI_SKIP_VERSION_CHECK: updates are owned by update-pi-sandbox.sh on the host
DOCKER_ARGS=(-e PI_SKIP_VERSION_CHECK=1)
